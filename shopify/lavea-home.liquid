<div class="xbar">✨ LAVÉA • هدايا راقية • 🚚 التوصيل في الجزائر</div><section class="xw xhero">{% if section.settings.hero_image!=blank %}{{section.settings.hero_image|image_url:width:2200|image_tag:loading:'eager'}}{% endif %}<div class="xcopy"><span class="xtag">LAVÉA · ARABIC LUXURY</span><h1>{{section.settings.hero_heading}}</h1><p>{{section.settings.hero_text}}</p><div class="xact"><a class="xbtn xmain" href="#lv-products">{{section.settings.primary_label}}</a>{% if wa!=blank %}<a class="xbtn xwa" target="_blank" href="https://wa.me/{{wa}}?text={{'السلام عليكم LAVÉA، نحب هدية مخصصة.'|url_encode}}">💬 هدية مخصصة</a>{% endif %}</div></div></section><div class="xw xtrust"><div class="xt">🎁<b>هدايا مختارة</b><span>ذوق وتفاصيل خاصة.</span></div><div class="xt">🛒<b>طلب عادي</b><span>السلة وCheckout Shopify.</span></div><div class="xt">💬<b>طلب مخصص</b><span>مباشرة على WhatsApp.</span></div><div class="xt">📦<b>للجزائر</b><span>تجربة شراء واضحة.</span></div></div><section class="xw xsec" id="lv-products"><div class="xhead"><div><div class="xk">CURATED COLLECTION</div><h2>{{section.settings.products_heading}}</h2></div><p class="xsub">{{section.settings.products_text}}</p></div>{% if products!=blank and products.products_count>0 %}<div class="xgrid">{% for p in products.products limit:8 %}{% assign v=p.selected_or_first_available_variant %}<article class="xc"><a class="xi" href="{{p.url}}">{% if p.featured_image %}{{p.featured_image|image_url:width:900|image_tag:widths:'420,650,900',loading:'lazy',alt:p.title}}{% endif %}<span class="pill">{% if v.available %}متوفر{% else %}غير متوفر{% endif %}</span></a><div class="xb"><h3><a href="{{p.url}}">{{p.title}}</a></h3><p class="price">{{p.price|money_without_trailing_zeros}}</p><form method="post" action="{{routes.cart_add_url}}"><input type="hidden" name="id" value="{{v.id}}"><button class="buy" type="submit" {% unless v.available %}disabled{% endunless %}>{% if v.available %}أضف إلى السلة{% else %}نفدت الكمية{% endif %}</button></form>{% if wa!=blank %}<a class="custom" target="_blank" href="https://wa.me/{{wa}}?text={{'هدية مخصصة: '|append:p.title|url_encode}}">💬 تخصيص الهدية</a>{% endif %}<div class="note">العادي = الموقع • المخصص = واتساب</div></div></article>{% endfor %}</div>{% endif %}</section><section class="xw xsec"><div class="xstory"><div class="xbox"><div class="xk">ABOUT LAVÉA</div><h2>{{section.settings.story_heading}}</h2><p>{{section.settings.story_1}}</p><p>{{section.settings.story_2}}</p></div><div class="xbox xmedia">{% if section.settings.story_image!=blank %}{{section.settings.story_image|image_url:width:1400|image_tag:loading:'lazy'}}{% else %}<div style="min-height:400px;display:grid;place-items:center;background:#eed8d2;font:60px Georgia;color:#7d4f4a">LAVÉA</div>{% endif %}</div></div></section><section class="xw xsec"><div class="x3"><div class="card">🎀<h3>تغليف وذوق</h3><p>الطلب العادي سريع، والتخصيص معنا عبر واتساب.</p></div><div class="card">🛒<h3>Checkout واضح</h3><p>الطلب العادي يمر من سلة Shopify إلى Checkout.</p></div><div class="card">💌<h3>هدية Custom</h3><p>مناسبة أو رسالة أو لون؟ ننسقوها مباشرة.</p></div></div></section>{% if wa!=blank %}<section class="xw xsec"><div class="custombox"><div><div class="xk">CUSTOM GIFT</div><h2>{{section.settings.custom_heading}}</h2><p>{{section.settings.custom_text}}</p></div><a class="xbtn" style="background:var(--i);color:#fff" target="_blank" href="https://wa.me/{{wa}}">💬 {{section.settings.custom_label}}</a></div></section>{% endif %}<section class="xw xsec"><div class="xhead"><div><div class="xk">HOW IT WORKS</div><h2>كيفاش تطلب؟</h2></div></div><div class="x3 steps"><div class="card"><div class="num">1</div><h3>اختار</h3><p>شوف المنتج والسعر.</p></div><div class="card"><div class="num">2</div><h3>عادي أو مخصص</h3><p>العادي من السلة، المخصص من واتساب.</p></div><div class="card"><div class="num">3</div><h3>نكملوا معك</h3><p>التفاصيل الخاصة ننسقوها في المحادثة.</p></div></div></section><section class="xw xsec"><div class="faq"><details open><summary>هل الطلب العادي يدخل للـ Orders؟</summary><p>نعم، يمر عبر سلة وCheckout Shopify.</p></details><details><summary>كيفاش نطلب هدية مخصصة؟</summary><p>اضغط واتساب وأرسل المناسبة والميزانية والرسالة والتغليف.</p></details><details><summary>هل المنتجات والأسعار تتحدث من Shopify؟</summary><p>نعم، الصفحة مربوطة مباشرة بكتالوج Shopify.</p></details></div></section><section class="xw xsec"><div class="end"><div><div class="xk" style="color:#d9b67c">LAVÉA</div><h2>هديتك تبدأ من الفكرة</h2><p>اطلب عادي من الموقع، أو حضّر هدية custom على واتساب.</p></div><a class="xbtn xmain" href="#lv-products">تسوّق الآن</a></div></section>{% if wa!=blank %}<a class="float" target="_blank" href="https://wa.me/{{wa}}">◉</a>{% endif %}<nav class="mob"><a href="/">⌂<span>الرئيسية</span></a><a href="#lv-products">♡<span>المنتجات</span></a>{% if wa!=blank %}<a target="_blank" href="https://wa.me/{{wa}}">◉<span>واتساب</span></a>{% endif %}<a href="{{routes.cart_url}}">🛒<span>السلة</span></a></nav></div>
{% schema %}{"name":"LAVÉA — Arabic Luxury","settings":[{"type":"text","id":"hero_heading","label":"Hero title","default":"هديتك تحكي عنك"},{"type":"textarea","id":"hero_text","label":"Hero text","default":"هدايا راقية ومنتجات مختارة بعناية — للّحظات اللي تستاهل تبقى في الذاكرة."},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"primary_label","label":"Primary button","default":"تسوّق الآن"},{"type":"text","id":"whatsapp_number","label":"WhatsApp number","default":" ","info":"رقم دولي بدون + أو مسافات"},{"type":"collection","id":"collection","label":"Product collection"},{"type":"text","id":"products_heading","label":"Products heading","default":"اختيارات LAVÉA"},{"type":"textarea","id":"products_text","label":"Products text","default":"المتوفر للشراء يظهر بزر السلة. التخصيص والتغليف الخاص يتم عبر واتساب."},{"type":"text","id":"story_heading","label":"Story heading","default":"الهدية ليست منتجاً فقط"},{"type":"textarea","id":"story_1","label":"Story paragraph 1","default":"في LAVÉA نهتم بالاختيار، العرض والتفاصيل الصغيرة اللي تخلي الهدية تحسّها خاصة."},{"type":"textarea","id":"story_2","label":"Story paragraph 2","default":"لهذا فرّقنا بين الطلب العادي السريع وبين الهدية المخصصة اللي تحتاج تواصل مباشر."},{"type":"image_picker","id":"story_image","label":"Story image"},{"type":"text","id":"custom_heading","label":"Custom gift heading","default":"عندك فكرة في بالك؟ نخليوها هدية."},{"type":"textarea","id":"custom_text","label":"Custom gift text","default":"ابعث المناسبة، الميزانية، الألوان، الرسالة وأي تفاصيل خاصة. ننسقوها معك على واتساب."},{"type":"text","id":"custom_label","label":"Custom button","default":"احجز هديتك المخصصة"}]}{% endschema %}