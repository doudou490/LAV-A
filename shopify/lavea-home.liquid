ground:#fff;border:1px solid var(--l);border-radius:20px;overflow:hidden}.xi{display:block;aspect-ratio:1;background:#f5ebe7;position:relative}.xi img{width:100%;height:100%;object-fit:cover}.pill{position:absolute;right:9px;top:9px;background:#fff;border-radius:99px;padding:6px 9px;font-size:11px}.xb{padding:14px}.xb h3{font-size:14px;line-height:1.6;margin:0 0 7px}.price{font-size:18px;font-weight:900;color:#7f4f4a;margin:0 0 10px}.buy,.custom{width:100%;min-height:42px;border-radius:12px;border:1px solid var(--l);font-weight:800}.buy{background:var(--i);color:#fff}.buy:disabled{opacity:.35}.custom{display:flex;align-items:center;justify-content:center;margin-top:7px;background:#f2e1dc;color:#603c38}.note{font-size:11px;color:#8c7e76;margin-top:6px}.xstory{display:grid;grid-template-columns:1fr 1fr;gap:20px}.xbox{background:#fff;border:1px solid var(--l);border-radius:26px;padding:35px}.xbox p{color:var(--m);line-height:2}.xmedia{padding:0;overflow:hidden}.xmedia img{width:100%;height:100%;object-fit:cover}.x3{grid-template-columns:repeat(3,1fr)}.card{background:#fff;border:1px solid var(--l);border-radius:20px;padding:22px}.card p{color:var(--m);line-height:1.8;margin:0}.custombox,.end{border-radius:28px;padding:35px;display:flex;justify-content:space-between;align-items:center;gap:20px}.custombox{background:linear-gradient(135deg,#f4e5e0,#edd8d2);border:1px solid var(--l)}.custombox p{color:var(--m);max-width:730px;line-height:1.8}.steps .card{background:var(--i);color:#fff}.steps .card p{color:#fffa}.num{width:38px;height:38px;border-radius:50%;background:var(--g);color:var(--i);display:grid;place-items:center;font-weight:900}.faq{padding:10px 22px;background:#fff;border:1px solid var(--l);border-radius:26px}.faq details{padding:15px 0;border-bottom:1px solid var(--l)}.faq summary{cursor:pointer;font-weight:800}.faq p{color:var(--m);line-height:1.8}.end{background:var(--i);color:#fff}.end p{color:#fff9}.float{position:fixed;left:18px;bottom:18px;width:55px;heig