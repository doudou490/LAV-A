{% liquid
  assign wa = section.settings.whatsapp_number | default: ''
  assign wan = wa | remove:'+' | remove:' ' | remove:'-' | remove:'(' | remove:')'
%}
<section id="lavea-cod-{{ section.id }}" class="lv-cod" dir="rtl" data-wilayas="https://cdn.jsdelivr.net/gh/DZBuild-com/dzship@main/data/wilayas.json" data-communes="https://cdn.jsdelivr.net/gh/DZBuild-com/dzship@main/data/communes.json">
  <div class="lv-cod-head"><span>الدفع عند الاستلام • COD</span><h2>اطلب هذا المنتج بسهولة</h2><p>عمّر المعلومات، اختار الولاية ثم البلدية، ونكملوا معك لتأكيد الطلب.</p></div>
  <form id="lv-cod-form-{{ section.id }}" class="lv-cod-form">
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {% unless product.has_only_default_variant %}
      <label><b>الاختيار</b><select class="lv-i" id="lv-variant-{{ section.id }}">{% for v in product.variants %}<option value="{{ v.id }}" {% if v.id == product.selected_or_first_available_variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — غير متوفر{% endunless %}</option>{% endfor %}</select></label>
    {% endunless %}
    <div class="lv-cod-grid">
      <label><b>الاسم واللقب</b><input class="lv-i" name="name" required autocomplete="name" placeholder="مثال: محمد بن علي"></label>
      <label><b>رقم الهاتف</b><input class="lv-i" name="phone" required inputmode="tel" autocomplete="tel" placeholder="05xxxxxxxx"></label>
      <label><b>الولاية</b><select class="lv-i" name="wilaya" id="lv-w-{{ section.id }}" required><option value="">اختر الولاية</option></select></label>
      <label><b>البلدية</b><select class="lv-i" name="commune" id="lv-c-{{ section.id }}" required disabled><option value="">اختر الولاية أولا</option></select></label>
      <label><b>التغليف</b><select class="lv-i" name="wrap"><option value="بدون تغليف">بدون تغليف</option><option value="تغليف هدية بسيط">تغليف هدية بسيط</option></select></label>
      <label class="full"><b>الملاحظة</b><textarea class="lv-i" name="note" rows="3" placeholder="وقت مناسب للاتصال، تفاصيل التوصيل..."> </textarea></label>
    </div>
    <div class="lv-cod-product"><strong>{{ product.title }}</strong><span>{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span></div>
    <button class="lv-cod-btn" type="submit">تأكيد الطلب • الدفع عند الاستلام <span>←</span></button>
    <p class="lv-cod-msg" aria-live="polite"></p>
  </form>
  {% if wan != blank %}<a class="lv-custom" href="https://wa.me/{{ wan }}?text={{ 'سلام، نحب نصنع هدية مخصصة من LAVÉA. المنتج: ' | append: product.title | url_encode }}" target="_blank" rel="noopener"><strong>🎁 صناعة هدية مخصصة</strong><small>تواصل معنا عبر WhatsApp للتغليف والتنسيق والطلبات الخاصة.</small><span>↗</span></a>{% endif %}
</section>
<style>
#lavea-cod-{{section.id}}{max-width:1040px;margin:48px auto;padding:0 18px;font-family:inherit;color:#2f231e}.lv-cod-head{text-align:center;margin-bottom:20px}.lv-cod-head span{display:inline-block;background:#f5e9df;color:#7c4f45;padding:7px 12px;border-radius:999px;font-size:12px;font-weight:800}.lv-cod-head h2{font-size:34px;margin:10px 0 6px}.lv-cod-head p{margin:0;color:#756b65}.lv-cod-form{border:1px solid #eaded5;border-radius:24px;padding:22px;background:#fff;box-shadow:0 16px 44px rgba(74,44,30,.07)}.lv-cod-form>label{display:grid;gap:6px;margin-bottom:14px}.lv-cod-form b{font-size:13px}.lv-cod-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.lv-cod-grid label{display:grid;gap:6px}.lv-cod-grid .full{grid-column:1/-1}.lv-i{width:100%;min-height:50px;border:1px solid #ded3cb;border-radius:13px;background:#fff;padding:10px 13px;font:inherit;box-sizing:border-box}.lv-i:focus{outline:none;border-color:#a9635d;box-shadow:0 0 0 4px #a9635d18}.lv-cod-product{display:flex;justify-content:space-between;gap:12px;background:#faf5f1;padding:14px;border-radius:14px;margin:15px 0;font-weight:800}.lv-cod-product span{color:#944f48}.lv-cod-btn{width:100%;min-height:54px;border:0;border-radius:15px;background:#702f28;color:#fff;font:inherit;font-weight:900;cursor:pointer;display:flex;justify-content:center;gap:10px}.lv-cod-btn:disabled{opacity:.6}.lv-cod-msg{text-align:center;min-height:20px;margin:10px 0 0;color:#716762;font-size:13px}.lv-custom{margin-top:13px;padding:15px 16px;border:1px solid #dfcbbb;border-radius:16px;background:linear-gradient(135deg,#fff8f2,#f5eae2);display:flex;align-items:center;gap:12px;text-decoration:none;color:#3c2c25}.lv-custom small{display:block;color:#786d67;margin-top:2px}.lv-custom span{margin-inline-start:auto;font-weight:900}@media(max-width:700px){#lavea-cod-{{section.id}}{padding:0 12px;margin:30px auto}.lv-cod-head h2{font-size:27px}.lv-cod-form{padding:15px;border-radius:20px}.lv-cod-grid{grid-template-columns:1fr}.lv-cod-grid .full{grid-column:auto}.lv-i{min-height:52px}.lv-custom{align-items:flex-start}}
</style>
<script>
(()=>{const r=document.getElementById('lavea-cod-{{section.id}}');if(!r)return;const f=r.querySelector('form'),w=r.querySelector('#lv-w-{{section.id}}'),c=r.querySelector('#lv-c-{{section.id}}'),m=r.querySelector('.lv-cod-msg'),b=r.querySelector('.lv-cod-btn'),v=r.querySelector('#lv-variant-{{section.id}}'),id=f.querySelector('input[name=id]');let ws=[],cs=[];const phoneOK=s=>{s=(s||'').replace(/[\s-]/g,'');return /^0[567]\d{8}$/.test(s)||/^\+213[567]\d{8}$/.test(s)};Promise.all([fetch(r.dataset.wilayas).then(x=>x.json()),fetch(r.dataset.communes).then(x=>x.json())]).then(([a,d])=>{ws=a||[];cs=d||[];ws.slice(0,58).forEach(x=>{const o=document.createElement('option');o.value=x.nameAr||x.name;o.dataset.code=x.code;o.textContent=(x.code+' — '+(x.nameAr||x.name));w.appendChild(o)})}).catch(()=>m.textContent='تعذر تحميل الولايات. حدّث الصفحة وحاول مجددا.');w.addEventListener('change',()=>{const code=w.options[w.selectedIndex]?.dataset.code;c.innerHTML='<option value="">اختر البلدية</option>';c.disabled=!code;if(code)cs.filter(x=>String(x.wilayaCode)===String(code)).forEach(x=>{const o=document.createElement('option');o.value=x.nameAr;o.textContent=x.nameAr;c.appendChild(o)})});v?.addEventListener('change',()=>id.value=v.value);f.addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(f),name=fd.get('name')?.trim(),ph=fd.get('phone')?.trim();if(!name||name.length<4)return m.textContent='أدخل الاسم واللقب كاملين.';if(!phoneOK(ph))return m.textContent='رقم الهاتف غير صالح.';if(!fd.get('wilaya')||!fd.get('commune'))return m.textContent='اختر الولاية والبلدية.';b.disabled=true;b.firstChild.textContent='جاري تأكيد الطلب...';try{await fetch('/cart/clear.js',{method:'POST'});const add=new FormData();add.append('id',id.value);add.append('quantity','1');add.append('properties[الاسم واللقب]',name);add.append('properties[رقم الهاتف]',ph);add.append('properties[الولاية]',fd.get('wilaya'));add.append('properties[البلدية]',fd.get('commune'));add.append('properties[التغليف]',fd.get('wrap'));add.append('properties[ملاحظة]',fd.get('note')||'');add.append('properties[طريقة الدفع]','الدفع عند الاستلام');const x=await fetch('/cart/add.js',{method:'POST',headers:{Accept:'application/json'},body:add});if(!x.ok)throw 0;await fetch('/cart/update.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attributes:{'COD الاسم واللقب':name,'COD الهاتف':ph,'COD الولاية':fd.get('wilaya'),'COD البلدية':fd.get('commune'),'COD التغليف':fd.get('wrap')}})});location.href='/checkout'}catch(_){b.disabled=false;b.firstChild.textContent='تأكيد الطلب • الدفع عند الاستلام';m.textContent='حدث خطأ بسيط، أعد المحاولة.'}})})();
</script>
{% schema %}{"name":"LAVÉA — COD v2","settings":[{"type":"text","id":"whatsapp_number","label":"رقم WhatsApp بصيغة دولية","default":""}],"presets":[{"name":"LAVÉA — طلب COD"}]}{% endschema %}