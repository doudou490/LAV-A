{% liquid
  assign wa = section.settings.whatsapp_number | default: ''
  assign wan = wa | remove:'+' | remove:' ' | remove:'-' | remove:'(' | remove:')'
  assign v = product.selected_or_first_available_variant
%}
<div id="lvp-{{section.id}}" data-lavea-product data-wilayas="https://cdn.jsdelivr.net/gh/dzbuild-com/dzship@main/data/wilayas.json" data-communes="https://cdn.jsdelivr.net/gh/dzbuild-com/dzship@main/data/communes.json" dir="rtl">
  <div class="lvp-wrap">
    <div>{% if product.featured_image %}<div class="lvp-main"><img src="{{product.featured_image|image_url:width:1200}}" alt="{{product.title|escape}}"></div>{% endif %}</div>
    <div class="lvp-info"><small>LAVÉA • TOUCH OF ELEGANCE</small><h1>{{product.title}}</h1><div class="price">{{product.price|money_without_trailing_zeros}}</div><p>{{product.description|strip_html|truncate:360}}</p>
      <form class="normal-cart" action="{{routes.cart_add_url}}" method="post"><label><b>الاختيار</b><select name="id" data-variant>{% for pv in product.variants %}<option value="{{pv.id}}" {% if pv.id==v.id %}selected{% endif %} {% unless pv.available %}disabled{% endunless %}>{{pv.title}}{% unless pv.available %} — غير متوفر{% endunless %}</option>{% endfor %}</select></label><label><b>الكمية</b><input name="quantity" type="number" min="1" value="1"></label><button type="submit">أضف إلى السلة</button></form>
      {% if wan != blank and wan != '0' %}<a class="wa" target="_blank" rel="noopener" href="https://wa.me/{{wan}}?text={{'سلام، نحب نطلب هدية مخصصة من LAVÉA. المنتج: '|append:product.title|url_encode}}">🎁 صناعة هدية مخصصة عبر WhatsApp</a>{% endif %}
    </div>
  </div>
  <div class="cod"><header><span>الدفع عند الاستلام • COD</span><h2>اطلب هذا المنتج الآن</h2><p>عمّر المعلومات، اختار الولاية ثم البلدية.</p></header>
    <form data-cod-form><input type="hidden" name="id" value="{{v.id}}">
      <div class="grid"><label><b>الاسم واللقب</b><input class="i" name="name" required autocomplete="name" placeholder="محمد بن علي"></label><label><b>رقم الهاتف</b><input class="i" name="phone" required inputmode="tel" autocomplete="tel" placeholder="05xxxxxxxx"></label><label><b>الولاية</b><select class="i" data-wilaya required><option value="">اختر الولاية</option></select></label><label><b>البلدية</b><select class="i" data-commune required disabled><option value="">اختر الولاية أولا</option></select></label><label><b>التغليف</b><select class="i" name="wrap"><option value="بدون تغليف">بدون تغليف</option><option value="تغليف هدية بسيط">تغليف هدية بسيط</option></select></label><label class="full"><b>الملاحظة</b><textarea class="i" name="note" rows="3" placeholder="ملاحظة للطلب..."></textarea></label></div>
      <div class="sum"><strong>{{product.title}}</strong><b>{{product.price|money_without_trailing_zeros}}</b></div><button class="codbtn" data-cod-submit type="submit">تأكيد الطلب • الدفع عند الاستلام ←</button><p data-msg aria-live="polite"></p>
    </form></div>
  {% if wan != blank and wan != '0' %}<a class="custom" target="_blank" rel="noopener" href="https://wa.me/{{wan}}?text={{'سلام، نحب هدية مخصصة من LAVÉA. المنتج: '|append:product.title|url_encode}}"><strong>🎁 صناعة هدية مخصصة</strong><span>WhatsApp ↗</span></a>{% endif %}
  <div class="details"><h2>تفاصيل المنتج</h2>{{product.description}}</div>
</div>
<link rel="stylesheet" href="{{ 'lavea-product-v2.css' | asset_url }}">
<script src="{{ 'lavea-product.js' | asset_url }}" defer></script>
<style>#lvp-{{section.id}}{max-width:1180px;margin:auto;padding:18px;color:#2d211d;font-family:inherit}.lvp-wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:30px}.lvp-main{aspect-ratio:1;background:#f6eee8;border-radius:24px;overflow:hidden}.lvp-main img{width:100%;height:100%;object-fit:cover}.lvp-info>small,.cod header span{font-size:11px;letter-spacing:.12em;color:#8d6c60;font-weight:900}.lvp-info h1{font:700 48px/1.1 Georgia,serif;margin:12px 0}.price{font-size:25px;font-weight:900;color:#8f4d46}.normal-cart{display:grid;gap:10px;margin-top:20px}.normal-cart label{display:grid;gap:6px}.normal-cart select,.normal-cart input{min-height:49px;border:1px solid #ddd1c9;border-radius:12px;padding:10px;font:inherit}.normal-cart button,.codbtn{min-height:53px;border:0;border-radius:13px;background:#6f302a;color:#fff;font:inherit;font-weight:900}.wa,.custom{display:flex;justify-content:center;margin-top:11px;padding:13px;border-radius:13px;text-decoration:none;background:#f1eee8;color:#3d5d42;font-weight:900}.cod{margin-top:55px;border:1px solid #eaded5;border-radius:25px;padding:24px;box-shadow:0 16px 45px rgba(70,42,28,.06)}.cod header{text-align:center}.cod header h2{font-size:34px;margin:10px 0 5px}.cod header p{color:#766c67}.grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.grid label{display:grid;gap:6px}.grid .full{grid-column:1/-1}.i{min-height:50px;border:1px solid #ddd1c9;border-radius:12px;padding:10px;font:inherit;box-sizing:border-box}.sum{display:flex;justify-content:space-between;margin:14px 0;padding:13px;border-radius:13px;background:#faf5f1}.sum b{color:#8f4d46}.custom{background:linear-gradient(135deg,#fff8f2,#f3e7de);justify-content:space-between;color:#382a24}.details{margin-top:50px;border-top:1px solid #eaded5;padding-top:30px;line-height:1.9}@media(max-width:760px){.lvp-wrap{grid-template-columns:1fr}.lvp-info h1{font-size:37px}.grid{grid-template-columns:1fr}.grid .full{grid-column:auto}.cod{padding:15px;border-radius:20px}}
</style>
{% schema %}{"name":"LAVÉA Product Page v2","settings":[{"type":"text","id":"whatsapp_number","label":"رقم WhatsApp بصيغة دولية"}],"presets":[{"name":"LAVÉA Product Page"}]}{% endschema %}