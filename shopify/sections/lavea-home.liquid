{% assign featured = section.settings.featured_collection %}
{% if featured == blank %}{% assign featured = collections['هدايا-وعطور-lavea'] %}{% endif %}
<div class="lavea-home" dir="rtl">
  <div class="lavea-topbar">🚚 توصيل سريع إلى 58 ولاية جزائرية &nbsp; • &nbsp; الدفع عند الاستلام</div>
  <section class="lavea-hero">
    <div class="lavea-hero__copy">
      <span class="lavea-kicker">LAVÉA • TOUCH OF ELEGANCE</span>
      <h1>{{ section.settings.hero_title }}</h1>
      <p>{{ section.settings.hero_text }}</p>
      <div class="lavea-actions"><a class="lavea-btn lavea-btn--dark" href="{{ section.settings.hero_link }}">تسوق الآن</a><a class="lavea-btn lavea-btn--light" href="#lavea-categories">اكتشف التصنيفات</a></div>
    </div>
    <div class="lavea-hero__media">
      {% if section.settings.hero_image != blank %}<img src="{{ section.settings.hero_image | image_url: width: 1800 }}" alt="{{ section.settings.hero_title | escape }}" loading="eager">
      {% else %}<div class="lavea-hero__placeholder"><span>🎁</span><strong>هديتك تحكي عنك</strong><small>اختيارات راقية لكل مناسبة</small></div>{% endif %}
    </div>
  </section>

  <section id="lavea-categories" class="lavea-section">
    <div class="lavea-section__head"><div><span class="lavea-kicker">SHOP BY CATEGORY</span><h2>تسوّق حسب الفئة</h2></div><a href="/collections">عرض الكل ←</a></div>
    <div class="lavea-cats">
      {% assign cats = 'toys-education|ألعاب وتعليم|🧸,gifts-women|هدايا نساء|🎁,gifts-men|هدايا رجال|⌚,accessories-women|إكسسوارات نساء|👜,accessories-men|إكسسوارات رجال|🕶️,perfumes-makeup|عطور وماكياج|🌸,watches|ساعات|⌚,glasses|نظارات|👓,other-products|أخرى|✨' | split: ',' %}
      {% for item in cats %}
        {% assign p=item | split:'|' %}{% assign col=collections[p[0]] %}
        <a class="lavea-cat" href="{{ col.url | default: '/collections/' | append: p[0] }}"><span>{{ p[2] }}</span><strong>{{ p[1] }}</strong></a>
      {% endfor %}
    </div>
  </section>

  <section class="lavea-trust"><div>✓<strong>منتجات مختارة</strong><small>جودة تستحق الثقة</small></div><div>🚚<strong>توصيل سريع</strong><small>58 ولاية</small></div><div>☎<strong>خدمة العملاء</strong><small>قبل تأكيد الطلب</small></div><div>💵<strong>الدفع عند الاستلام</strong><small>COD</small></div></section>

  <section class="lavea-section">
    <div class="lavea-section__head"><div><span class="lavea-kicker">BEST PICKS</span><h2>الأكثر طلباً</h2></div><a href="{{ featured.url | default: '/collections/all' }}">عرض الكل ←</a></div>
    <div class="lavea-products">
      {% for product in featured.products limit:8 %}
        <article class="lavea-card">
          <a class="lavea-card__img" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy">{% else %}<span>✨</span>{% endif %}</a>
          <div class="lavea-card__body"><h3>{{ product.title }}</h3><strong>{{ product.price | money }}</strong><a class="lavea-mini" href="{{ product.url }}">اطلب الآن</a></div>
        </article>
      {% else %}<div class="lavea-empty">أضف المنتجات من Shopify ليظهر الكاتالوغ هنا مباشرة.</div>{% endfor %}
    </div>
  </section>

  <section class="lavea-story"><div><span class="lavea-kicker">OUR STORY</span><h2>{{ section.settings.story_title }}</h2><p>{{ section.settings.story_text }}</p><a class="lavea-btn lavea-btn--dark" href="/pages/about">قصتنا</a></div><div class="lavea-story__badge"><span>✦</span><strong>LAVÉA</strong><small>اختيار • أناقة • لمسة شخصية</small></div></section>

  {% if section.settings.whatsapp_number != blank %}
    {% assign wan=section.settings.whatsapp_number | remove:'+' | remove:' ' | remove:'-' | remove:'(' | remove:')' %}
    <section class="lavea-custom"><div><span class="lavea-kicker">PERSONALIZED GIFT</span><h2>اصنع هديتك بطريقتك</h2><p>تغليف، تنسيق، اختيار خاص أو هدية لشخص معيّن؟ خليها علينا عبر WhatsApp.</p></div><a class="lavea-btn lavea-btn--dark" target="_blank" rel="noopener" href="https://wa.me/{{ wan }}?text={{ 'سلام، نحب نصنع هدية مخصصة من LAVÉA. نحب نعرف الخيارات والأسعار.' | url_encode }}">تواصل عبر WhatsApp ↗</a></section>
  {% endif %}

  <section class="lavea-steps"><div class="lavea-section__head"><div><span class="lavea-kicker">HOW IT WORKS</span><h2>الطلب سهل</h2></div></div><div class="lavea-stepgrid"><div><b>1</b><h3>اختار المنتج</h3><p>شوف التفاصيل والخيارات.</p></div><div><b>2</b><h3>عمّر الفورم</h3><p>الاسم، الهاتف، الولاية والبلدية.</p></div><div><b>3</b><h3>أكد الطلب</h3><p>نتواصل معك ونحضّر الشحنة COD.</p></div></div></section>

  <section class="lavea-faq"><div class="lavea-section__head"><div><span class="lavea-kicker">FAQ</span><h2>أسئلة متكررة</h2></div></div>
    <details><summary>هل الدفع عند الاستلام؟</summary><p>نعم، الطلب العادي يتم عبر الموقع بنظام الدفع عند الاستلام.</p></details>
    <details><summary>كيف نطلب هدية مخصصة؟</summary><p>اضغط على «صناعة هدية مخصصة» وتواصل معنا عبر WhatsApp لتنسيق الطلب.</p></details>
    <details><summary>هل التوصيل متوفر في كامل 58 ولاية؟</summary><p>فورم الطلب يحتوي على 58 ولاية، وبعد اختيار الولاية تظهر البلديات التابعة لها.</p></details>
  </section>
  {% if section.settings.whatsapp_number != blank %}<nav class="lavea-mobilebar"><a href="/">⌂<span>الرئيسية</span></a><a href="#lavea-categories">☷<span>التصنيفات</span></a><a href="/cart">🛍<span>السلة</span></a><a href="https://wa.me/{{ wan }}" target="_blank" rel="noopener">💬<span>واتساب</span></a></nav>{% endif %}
</div>
<style>
.lavea-home{--ink:#2d211d;--muted:#746964;--accent:#9e514a;--cream:#f7f0ea;--line:#e8ddd5;color:var(--ink);background:#fff;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}.lavea-topbar{background:#f3e7dd;text-align:center;padding:9px 12px;font-size:13px;font-weight:800}.lavea-hero{max-width:1200px;margin:18px auto 58px;padding:0 20px;display:grid;grid-template-columns:1fr 1.12fr;gap:24px;align-items:stretch}.lavea-hero__copy{background:linear-gradient(135deg,#fbf4ef,#f2e4db);border:1px solid #eadbd0;border-radius:30px;padding:58px 52px;display:flex;flex-direction:column;justify-content:center}.lavea-kicker{font-size:11px;letter-spacing:.15em;font-weight:900;color:#8c6b5e}.lavea-hero h1{font:700 clamp(44px,5vw,72px)/1.04 Georgia,serif;margin:18px 0 14px}.lavea-hero p{font-size:18px;line-height:1.9;max-width:560px;color:var(--muted)}.lavea-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.lavea-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 21px;border-radius:999px;text-decoration:none;font-weight:900}.lavea-btn--dark{background:#6e312a;color:#fff}.lavea-btn--light{background:#fff;border:1px solid var(--line);color:#4e4039}.lavea-hero__media{min-height:520px;border-radius:30px;overflow:hidden;border:1px solid #eadbd0;background:linear-gradient(135deg,#efe0d3,#fbf6f1)}.lavea-hero__media img{width:100%;height:100%;object-fit:cover}.lavea-hero__placeholder{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:30px}.lavea-hero__placeholder span{font-size:78px}.lavea-hero__placeholder strong{font:700 44px Georgia,serif}.lavea-hero__placeholder small{margin-top:10px;color:var(--muted)}.lavea-section{max-width:1200px;margin:0 auto 72px;padding:0 20px}.lavea-section__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}.lavea-section__head h2{font:700 38px/1.1 Georgia,serif;margin:7px 0 0}.lavea-section__head a{color:#8e5f54;text-decoration:none;font-weight:800}.lavea-cats{display:grid;grid-template-columns:repeat(9,1fr);gap:10px}.lavea-cat{text-decoration:none;color:var(--ink);text-align:center}.lavea-cat span{display:flex;align-items:center;justify-content:center;aspect-ratio:1;border:1px solid var(--line);border-radius:50%;background:#fbf6f1;font-size:28px;box-shadow:0 8px 22px rgba(70,42,28,.06);transition:.2s}.lavea-cat strong{display:block;margin-top:8px;font-size:12px}.lavea-cat:hover span{transform:translateY(-3px);box-shadow:0 12px 24px rgba(70,42,28,.11)}.lavea-trust{max-width:1160px;margin:-28px auto 70px;padding:0 20px;display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:20px;overflow:hidden;background:#fff}.lavea-trust>div{padding:16px 14px;text-align:center;border-left:1px solid var(--line)}.lavea-trust>div:last-child{border-left:0}.lavea-trust strong{display:block;font-size:13px}.lavea-trust small{color:var(--muted)}.lavea-products{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.lavea-card{border:1px solid var(--line);border-radius:20px;overflow:hidden;background:#fff}.lavea-card__img{display:block;aspect-ratio:1;background:#f7f0ea}.lavea-card__img img{width:100%;height:100%;object-fit:cover}.lavea-card__img span{height:100%;display:grid;place-items:center;font-size:46px}.lavea-card__body{padding:14px}.lavea-card h3{font-size:15px;line-height:1.5;margin:0 0 7px}.lavea-card strong{display:block;color:#914d47;font-size:17px;margin-bottom:11px}.lavea-mini{display:inline-flex;align-items:center;justify-content:center;min-height:42px;width:100%;border-radius:12px;background:#faf6f2;color:#6a372f;text-decoration:none;font-weight:900}.lavea-story,.lavea-custom,.lavea-steps,.lavea-faq{max-width:1200px;margin:0 auto 72px;padding:0 20px}.lavea-story{display:grid;grid-template-columns:1.3fr .7fr;gap:20px}.lavea-story>div:first-child{border:1px solid var(--line);border-radius:28px;padding:40px;background:#fff}.lavea-story h2,.lavea-custom h2{font:700 38px/1.15 Georgia,serif;margin:9px 0}.lavea-story p,.lavea-custom p{max-width:700px;color:var(--muted);line-height:1.9}.lavea-story__badge{border-radius:28px;background:linear-gradient(145deg,#6b332c,#9c6d63);color:#fff;display:grid;place-items:center;text-align:center;min-height:280px}.lavea-story__badge span{font-size:34px}.lavea-story__badge strong{font:700 50px Georgia,serif}.lavea-story__badge small{opacity:.85}.lavea-custom{background:linear-gradient(120deg,#faf0e8,#f2e2d5);border:1px solid #e8d6c8;border-radius:28px;padding:32px;display:flex;justify-content:space-between;align-items:center;gap:30px}.lavea-stepgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.lavea-stepgrid>div{border:1px solid var(--line);border-radius:20px;padding:25px;background:#fff}.lavea-stepgrid b{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:#6f332b;color:#fff}.lavea-stepgrid h3{margin:14px 0 5px}.lavea-stepgrid p{margin:0;color:var(--muted)}.lavea-faq details{border-bottom:1px solid var(--line);padding:16px 0}.lavea-faq summary{cursor:pointer;font-weight:900}.lavea-faq p{color:var(--muted);line-height:1.8;margin:10px 0}.lavea-empty{grid-column:1/-1;padding:30px;border:1px dashed var(--line);border-radius:20px;text-align:center;color:var(--muted)}.lavea-mobilebar{display:none}@media(max-width:900px){.lavea-hero{grid-template-columns:1fr}.lavea-hero__media{min-height:380px}.lavea-cats{grid-template-columns:repeat(5,1fr)}.lavea-products{grid-template-columns:repeat(2,1fr)}.lavea-story{grid-template-columns:1fr}.lavea-trust{grid-template-columns:repeat(2,1fr)}.lavea-trust>div:nth-child(2){border-left:0}.lavea-stepgrid{grid-template-columns:1fr}}@media(max-width:640px){.lavea-topbar{font-size:11px}.lavea-hero{padding:0 12px;margin-top:10px}.lavea-hero__copy{padding:32px 23px}.lavea-hero h1{font-size:42px}.lavea-hero p{font-size:16px}.lavea-hero__media{min-height:300px}.lavea-section,.lavea-story,.lavea-custom,.lavea-steps,.lavea-faq{padding:0 12px;margin-bottom:48px}.lavea-section__head h2{font-size:29px}.lavea-cats{grid-template-columns:repeat(3,1fr);gap:12px}.lavea-trust{margin:-20px 12px 48px;padding:0;grid-template-columns:repeat(2,1fr)}.lavea-trust>div{padding:13px 8px}.lavea-card__body{padding:11px}.lavea-card h3{font-size:13px}.lavea-card strong{font-size:15px}.lavea-custom{display:block;padding:25px}.lavea-custom .lavea-btn{width:100%;margin-top:14px}.lavea-mobilebar{position:fixed;bottom:0;left:0;right:0;background:rgba(255,255,255,.96);backdrop-filter:blur(14px);border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:8px 6px env(safe-area-inset-bottom);z-index:50}.lavea-mobilebar a{display:grid;gap:3px;justify-items:center;text-decoration:none;color:var(--ink);font-size:18px}.lavea-mobilebar span{font-size:10px;font-weight:800}.lavea-home{padding-bottom:72px}}
</style>
{% schema %}
{"name":"LAVÉA — الصفحة الرئيسية","settings":[{"type":"image_picker","id":"hero_image","label":"صورة الهيرو"},{"type":"text","id":"hero_title","label":"عنوان الهيرو","default":"هديتك تحكي عنك"},{"type":"textarea","id":"hero_text","label":"نص الهيرو","default":"اختيارات راقية، هدايا مميزة، ولمسة شخصية لكل مناسبة."},{"type":"url","id":"hero_link","label":"رابط زر الهيرو"},{"type":"collection","id":"featured_collection","label":"مجموعة المنتجات"},{"type":"text","id":"story_title","label":"عنوان القصة","default":"أناقة جزائرية بلمسة شخصية"},{"type":"textarea","id":"story_text","label":"نص القصة","default":"في LAVÉA نختار المنتجات ونقدّمها بطريقة بسيطة وراقية، مع تجربة طلب مريحة ودعم سريع للزبون."},{"type":"text","id":"whatsapp_number","label":"رقم WhatsApp بصيغة دولية","default":""}],"presets":[{"name":"LAVÉA — الصفحة الرئيسية"}]}
{% endschema %}